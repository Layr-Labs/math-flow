    {
      "action": "issue",
      "adjudicationId": "triangle-midpoints/altitude-scaling",
      "nodeId": "triangle-midpoints/altitude-scaling",
      "parentId": "triangle-midpoints/equal-area",
      "nodeType": "claim",
      "title": "Altitude scaling under the midpoint homothety",
      "summary": "Under the homothety centered at A with scale factor one half, the distance from A to line EF is half the distance from A to line BC. Parallelism does not make those altitudes equal; scaling both the base and corresponding altitude by one half yields the quarter-area computation. Attribution of the rejected wording to an unavailable external report remains unverified.",

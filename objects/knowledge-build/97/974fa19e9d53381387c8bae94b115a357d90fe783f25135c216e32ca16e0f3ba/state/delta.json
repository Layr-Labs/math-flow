    {
      "action": "create",
      "nodeId": "triangle-midpoints/midpoint-segment-relations",
      "parentId": "triangle-midpoints/equal-area-program",
      "nodeType": "lemma",
      "title": "Parallelism and half-length relations for triangle midpoint segments",
      "summary": "For D=(B+C)/2, E=(C+A)/2, and F=(A+B)/2, the accepted vector identities show EF is parallel to BC, FD is parallel to CA, and DE is parallel to AB, with each midpoint segment having half the length of its corresponding side. Endpoint-order signs do not affect these parallelism or length conclusions.",

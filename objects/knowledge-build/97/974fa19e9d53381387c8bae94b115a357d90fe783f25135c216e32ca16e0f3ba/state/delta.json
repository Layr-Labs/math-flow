    {
      "action": "create",
      "nodeId": "triangle-midpoints/corner-altitude-scaling",
      "parentId": "triangle-midpoints/corner-triangles-quarter-area",
      "nodeType": "lemma",
      "title": "Altitude scaling under the corner midpoint homothety",
      "summary": "Under the factor-1/2 homothety centered at a corner, the opposite side maps to the corresponding midpoint segment and point-to-line distances scale by 1/2. Thus the altitude to the midpoint segment is half, not equal to, the altitude to the original opposite side; cyclic analogues hold at the other vertices. The unsupplied source of the rejected wording limits attribution but not the accepted mathematical conclusion.",

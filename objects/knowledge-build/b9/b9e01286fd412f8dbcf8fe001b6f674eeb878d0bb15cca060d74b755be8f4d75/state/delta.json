    {
      "action": "create",
      "nodeId": "programs/record-perturbation-rigidity/depth-two-local-rigidity",
      "parentId": "programs/record-perturbation-rigidity",
      "nodeType": "result",
      "title": "Saturation and depth-two rigidity of the specified embeddings",
      "summary": "Each specified 152-point embedding is inclusion-maximal in G_77. Removing one embedded point frees no originally outside cell, while removing any two frees at most one. Consequently, every no-three-in-line set of size at least 153 is at symmetric-difference distance at least seven from each specified embedding. No conclusion is established for removal depth three or greater or for unrelated configurations.",

    {
      "action": "update",
      "nodeId": "programs/explicit-coloring-certificates/hamming-distance-decomposition-at-537",
      "parentId": "programs/explicit-coloring-certificates",
      "nodeType": "lemma",
      "title": "Hamming-distance decomposition for extensions through 537",
      "summary": "For an extension assigning color c to 537, the distance from the fixed baseline on the first 536 positions equals the blocker count b_c plus the number of extra changes. At radius 60, color 1 is directly excluded and colors 2 through 6 permit at most 17, 5, 22, 28, and 25 extra changes respectively. The auxiliary-variable encoding exactly counts those extra changes, but the five conditioned cases are not proved unsatisfiable without their LRAT payloads.",

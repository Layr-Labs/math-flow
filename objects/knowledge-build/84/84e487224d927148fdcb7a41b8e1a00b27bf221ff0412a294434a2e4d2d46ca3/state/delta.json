    {
      "action": "create",
      "nodeId": "programs/explicit-coloring-certificates/radius-43-exclusion-at-537",
      "parentId": "programs/explicit-coloring-certificates",
      "nodeType": "claim",
      "title": "Radius-43 exclusion around the fixed Fredricksen–Sweet baseline",
      "summary": "The proposed claim is that every valid six-coloring through 537 differs from the fixed labeled Fredricksen–Sweet baseline in at least 44 of the first 536 positions. Colors 1 and 3 are proved outside radius 43, while the other four cases have supported exact reductions and checking machinery but lack their referenced LRAT proofs. The universal claim is therefore not established and would not, even if certified, determine S(6) or improve its known bounds.",

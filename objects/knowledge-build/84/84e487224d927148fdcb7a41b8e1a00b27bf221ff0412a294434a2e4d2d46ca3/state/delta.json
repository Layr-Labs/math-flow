    {
      "action": "create",
      "nodeId": "programs/explicit-coloring-certificates/blocker-pairs-at-537",
      "parentId": "programs/explicit-coloring-certificates",
      "nodeType": "lemma",
      "title": "Blocker pairs for assigning a color to 537 relative to the fixed baseline",
      "summary": "Relative to the fixed Fredricksen–Sweet coloring, the blocker-pair counts for prospective colors 1 through 6 at 537 are (64,43,55,38,32,35). The 268 complementary pairs are disjoint, so each color-c blocker forces at least one changed baseline position. Colors 1 and 3 therefore require at least 64 and 55 changes respectively and are directly outside Hamming radius 43. The lemma does not exclude the other colors or more distant colorings.",
      "reportSection": "## Node: programs/explicit-coloring-certificates/blocker-pairs-at-537",

    {
      "action": "create",
      "nodeId": "programs/explicit-coloring-certificates/hamming-distance-decomposition-at-537",
      "parentId": "programs/explicit-coloring-certificates",
      "nodeType": "lemma",
      "title": "Hamming-distance decomposition for extensions through 537",
      "summary": "For a prospective extension assigning color c to 537, the distance from the fixed baseline on the first 536 positions equals the blocker count b_c plus the number of extra changes. At radius 43, the remaining conditioned colors 2, 4, 5, and 6 permit at most 0, 5, 11, and 8 extra changes respectively. This is an exact supported reduction, not a proof that those four cases are unsatisfiable.",

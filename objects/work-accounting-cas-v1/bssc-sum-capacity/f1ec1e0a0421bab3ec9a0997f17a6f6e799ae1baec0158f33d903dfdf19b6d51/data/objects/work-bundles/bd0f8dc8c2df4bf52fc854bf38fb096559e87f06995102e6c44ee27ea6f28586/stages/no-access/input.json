    "facts": [
      {
        "id": "channel-specific-consistency-required",
        "condition": "The entropic model surviving the coarse relaxation is incompatible with a posterior-consistency implication imposed by the binary channel transition law. Excluding it requires channel-specific distributional constraints or a direct code-level argument, rather than universal entropy geometry and copy constructions alone.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "thread",
            "id": "root/unstructured-search"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/code-induced-dependence-balance-and-entropy-no-go"
        ]
      },
      {
        "id": "code-induced-output-balance",
        "condition": "For any vanishing-error sequence of deterministic private-message block codes, uniformly sampling one channel use while retaining the complementary output history yields two message-dependence terms, conditioned respectively on the sampled outputs of the two receivers, whose difference approaches zero. The sampled input must remain the output of the original coordinate encoder rather than a history-selected replacement map.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "thread",
            "id": "root/unstructured-search"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/code-induced-dependence-balance-and-entropy-no-go"
        ]
      },
      {
        "id": "entropy-copy-relaxation-obstruction",
        "condition": "A converse relaxation based only on the relevant entropy data, code-structure equalities, balanced message dependence, erasure-type conditional identities, scalar support constraints, universal finite-variable information inequalities, and finitely many ordinary copy extensions still admits a finite entropic model at the classical UV benchmark. That relaxation class therefore cannot certify a strictly stronger converse by itself.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "thread",
            "id": "root/unstructured-search"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/code-induced-dependence-balance-and-entropy-no-go"
        ]
      }
    ],
    "assumptions": [
      "The accepted judgment is authoritative only for the manifested accepted claim identity and its stated mathematical scope.",
      "These facts do not establish an exact sum-capacity, a new achievable scheme, or a tighter numerical capacity bound.",
      "Vanishing-error code sequences have bounded rates, so their decoding-uncertainty defects vanish asymptotically."
    ],

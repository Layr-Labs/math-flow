  "claims": [
    {
      "claimKey": "bssc-sum-capacity/two-letter-marton-full-support-necessity",
      "statement": "For the half-skew BSSC product channel P^{otimes 2}, every finite Marton law whose induced super-input X_1X_2 is supported on at most three of {00,01,10,11} has unnormalized Marton sum value strictly below 0.695 bits. A fair one-letter randomized-time-division schedule with reflected rational conditional priors 1/6 and 5/6, repeated independently twice, has exact unnormalized value B_{1/6}=2h_2(1/4)+h_2(1/12)-h_2(5/12)-1/3>0.7231 bits. Therefore every strict two-letter Marton improvement over twice the optimal one-letter randomized-time-division value must assign positive mass to all four super-input symbols. Quantitatively, every such improving witness must assign mass greater than 1/180 to each of 00 and 11 and mass greater than 1/325 to each of 01 and 10. This is a support-pruning theorem for the two-letter Marton functional, not a full-support no-gain theorem or an unrestricted capacity converse.",
      "dependencyTransactionIds": []
    }
  ]
}

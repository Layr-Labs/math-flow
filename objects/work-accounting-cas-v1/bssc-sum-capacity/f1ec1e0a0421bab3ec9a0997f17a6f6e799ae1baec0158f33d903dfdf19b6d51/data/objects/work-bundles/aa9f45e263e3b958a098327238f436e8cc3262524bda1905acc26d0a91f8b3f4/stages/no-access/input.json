    "facts": [
      {
        "id": "half-skew-tensor-power-specialization",
        "condition": "For n uses of the canonical half-skew BSSC, each accepted scalar relaxation evaluates to n times the exact single-use quantity 2h_2(1/4)-5/4 bits. This result is confined to those separate scalar relaxations and does not establish tensorization of a joint UV optimization or determine sum-capacity.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "program",
            "id": "root/uv-scalar-converse"
          },
          {
            "kind": "thread",
            "id": "root/uv-scalar-converse-agenda"
          },
          {
            "kind": "thread",
            "id": "root/uv-scalar-converse/product-and-skew-symmetry"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/uv-relaxed-converse-tensorization"
        ]
      },
      {
        "id": "uv-scalar-product-law",
        "condition": "For the accepted claim’s separately concavified scalar UV bounds, a product broadcast channel has an averaged optimum equal to the sum of the factor optima, even when candidate inputs and auxiliary decompositions correlate the factors. If receiver exchange is induced by an input involution, the branchwise and averaged optima coincide and symmetry-fixed input laws suffice.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "program",
            "id": "root/uv-scalar-converse"
          },
          {
            "kind": "thread",
            "id": "root/uv-scalar-converse/product-and-skew-symmetry"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/uv-relaxed-converse-tensorization"
        ]
      }
    ],
    "assumptions": [
      "All product lengths are finite positive integers.",
      "Channel products, concave envelopes, and binary entropy are interpreted using the canonical problem’s fixed definitions.",
      "The half-skew specialization assumes the previously established sharp posterior-support inequality on which the accepted claim depends."
    ],

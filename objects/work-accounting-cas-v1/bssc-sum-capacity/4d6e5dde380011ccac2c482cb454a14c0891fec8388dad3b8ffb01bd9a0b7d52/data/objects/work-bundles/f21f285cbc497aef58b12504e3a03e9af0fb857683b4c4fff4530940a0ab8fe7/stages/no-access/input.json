    "facts": [
      {
        "id": "finite-mesh-receiver-compression",
        "condition": "On a finite prior mesh containing both endpoints and the unbiased prior, each receiver admits an atomic posterior representation with no more atoms than mesh sites and with the same sampled information profile; mirror structure can be retained when the mesh is mirror invariant.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "program",
            "id": "root/theorem9-auxiliary-receiver-converse"
          },
          {
            "kind": "thread",
            "id": "root/theorem9-auxiliary-receiver-converse/r0-specialization-and-receiver-reduction"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/finite-grid-q0-foundations"
        ]
      },
      {
        "id": "midpoint-coercive-barrier",
        "condition": "Every finite-alphabet input-only receiver pair obeys a pointwise lower barrier determined separately by its two midpoint information values; consequently, a converse candidate lying between the canonical midpoint constant and twice that constant confines both midpoint values to an explicit bounded interval.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "program",
            "id": "root/uv-scalar-converse"
          },
          {
            "kind": "thread",
            "id": "root/uv-scalar-converse-agenda"
          },
          {
            "kind": "thread",
            "id": "root/uv-scalar-converse/product-and-skew-symmetry"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/finite-grid-q0-foundations"
        ]
      },
      {
        "id": "three-site-grid-optimum",
        "condition": "For the endpoint–midpoint–endpoint mesh, the finite-receiver minimization and its mirror-paired restriction have the same exact optimum, equal to the canonical midpoint entropy constant.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "program",
            "id": "root/uv-scalar-converse"
          },
          {
            "kind": "thread",

    "facts": [
      {
        "id": "sf-uv-symmetry-tensor-law",
        "condition": "For a two-receiver channel whose relabeling symmetry exchanges the receiver marginals, orbit-averaging turns the lesser of the two separately relaxed UV branches into the balanced UV scalar. Because that balanced scalar tensorizes, finite repetitions of the half-skew BSSC cannot strengthen this particular converse by coupling coordinates, even with block-level priors and concavification variables.",
        "actorVisibility": "withheld-until-independent-discovery",
        "affectedNodeRefs": [
          {
            "kind": "program",
            "id": "root/code-structure-converse"
          },
          {
            "kind": "thread",
            "id": "root/code-structure-converse/dependence-balance-and-channel-refinement"
          }
        ],
        "acceptedClaimKeys": [
          "bssc-sum-capacity/uv-product-branchwise-additivity"
        ]
      }
    ],
    "assumptions": [
      "The canonical half-skew BSSC has the receiver-exchange relabeling needed for the symmetry argument.",
      "The fact concerns only this UV converse route and does not assert an exact sum-capacity value.",
      "The two UV branches are independently relaxed scalar bounds; they are not the complete jointly constrained UV region."
    ],
    "safeFactsDigest": "sha256:6847daebd8fbd4202f20d4180bc2ea2a5257a04c077f7b8b53b64d779771fe50"
  },

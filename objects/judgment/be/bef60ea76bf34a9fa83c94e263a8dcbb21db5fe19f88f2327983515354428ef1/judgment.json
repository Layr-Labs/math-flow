      ]
    },
    {
      "claimKey": "triangle-midpoints/area-aef-one-quarter",
      "stance": "supports",
      "summary": "area(AEF) = (1/4) area(ABC) is established: with E=(A+C)/2 and F=(A+B)/2 the vectors E−A and F−A are half those of C−A and B−A, so the determinant/base×height argument (or homothety scaling by 1/2) yields area(AEF)=1/4·area(ABC).",
      "subjectTransactionIds": [
        "8bcf66bbd7777ee31f637a0a1a144535feb82ba4"
      ],

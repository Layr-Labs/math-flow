              ]
            },
            "pointer": "/id"
          },
          "right": {
            "operation": "map",
            "value": {
              "operation": "filter",
              "value": {
                "operation": "values",
                "value": {
                  "artifact": "fixed-base-state",
                  "pointer": "/programs"
                }
              },
              "where": [
                {
                  "pointer": "/parentId",
                  "operator": "equals",
                  "expected": "root"
                }
              ]
            },
            "pointer": "/id"
          }
        }
      },
      "operator": "equals",
      "expected": 1,

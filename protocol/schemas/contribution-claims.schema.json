{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/contribution-claims.schema.json",
  "title": "Math Flow Contribution Claims",
  "type": "object",
  "required": ["schemaVersion", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claimKey", "statement", "dependencyTransactionIds"],
        "properties": {
          "claimKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
          "statement": { "type": "string", "minLength": 1 },
          "dependencyTransactionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

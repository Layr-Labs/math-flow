{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/joint-portfolio-serial-author-response-v2.schema.json",
  "title": "Joint Portfolio Serial Topology, Result, and Live-W+ Author Response V2",
  "type": "object",
  "required": [
    "schemaVersion",
    "subjectTransactionId",
    "baseStateDigest",
    "baseAccountingStateDigest",
    "baseBoundaryStateDigest",
    "semanticPacketDigest",
    "authoringPacketDigest",
    "programChanges",
    "resultPlacements",
    "programBoundaries",
    "withAccessAssessments",
    "topologyRationale"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "subjectTransactionId": { "$ref": "#/$defs/transaction" },
    "baseStateDigest": { "$ref": "#/$defs/digest" },
    "baseAccountingStateDigest": { "$ref": "#/$defs/digest" },
    "baseBoundaryStateDigest": { "$ref": "#/$defs/digest" },
    "semanticPacketDigest": { "$ref": "#/$defs/digest" },
    "authoringPacketDigest": { "$ref": "#/$defs/digest" },
    "programChanges": {
      "type": "array",
      "items": { "$ref": "#/$defs/programChange" }
    },
    "resultPlacements": {
      "type": "array",
      "items": { "$ref": "#/$defs/resultPlacement" }
    },
    "programBoundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/programBoundary" }
    },
    "withAccessAssessments": {
      "type": "array",
      "items": { "$ref": "#/$defs/withAccessAssessment" }
    },
    "topologyRationale": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transaction": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]*$"
    },
    "nonemptyText": {
      "type": "string",
      "minLength": 1
    },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
    },
    "programChange": {
      "type": "object",
      "required": [
        "action",
        "programId",
        "baseDigest",
        "parentId",
        "title",
        "objective",
        "currentStateSummary",
        "localResidualSummary",
        "status"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "refresh", "move", "retire"]
        },
        "programId": { "$ref": "#/$defs/id" },
        "baseDigest": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "parentId": {
          "anyOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "title": { "$ref": "#/$defs/nonemptyText" },
        "objective": { "$ref": "#/$defs/nonemptyText" },
        "currentStateSummary": { "$ref": "#/$defs/nonemptyText" },
        "localResidualSummary": { "$ref": "#/$defs/nonemptyText" },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "retired"]
        }
      },
      "additionalProperties": false
    },
    "resultPlacement": {
      "type": "object",
      "required": ["resultId", "primaryProgramId", "relatedProgramIds"],
      "properties": {
        "resultId": { "$ref": "#/$defs/id" },
        "primaryProgramId": { "$ref": "#/$defs/id" },
        "relatedProgramIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    },
    "programBoundary": {
      "type": "object",
      "required": [
        "programId",
        "directResidualWorkScope",
        "activationCondition",
        "stoppingCondition",
        "independentVariationRationale"
      ],
      "properties": {
        "programId": { "$ref": "#/$defs/id" },
        "directResidualWorkScope": { "$ref": "#/$defs/nonemptyText" },
        "activationCondition": { "$ref": "#/$defs/nonemptyText" },
        "stoppingCondition": { "$ref": "#/$defs/nonemptyText" },
        "independentVariationRationale": { "$ref": "#/$defs/nonemptyText" }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "accepted-claim",
            "submission-evidence",
            "prior-program",
            "prior-result",
            "semantic-result"
          ]
        },
        "id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "withAccessAssessment": {
      "type": "object",
      "required": [
        "programId",
        "directWorkHours",
        "conditionalIncidence",
        "rationale",
        "evidenceRefs"
      ],
      "properties": {
        "programId": { "$ref": "#/$defs/id" },
        "directWorkHours": { "$ref": "#/$defs/canonicalDecimal" },
        "conditionalIncidence": {
          "anyOf": [
            { "$ref": "#/$defs/canonicalDecimal" },
            { "type": "null" }
          ]
        },
        "rationale": { "$ref": "#/$defs/nonemptyText" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      },
      "additionalProperties": false
    }
  }
}

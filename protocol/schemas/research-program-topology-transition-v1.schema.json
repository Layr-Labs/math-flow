{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/research-program-topology-transition-v1.schema.json",
  "title": "Research Program Topology Transition v1",
  "type": "object",
  "required": ["schemaVersion", "baseStateDigest", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseStateDigest": { "$ref": "#/$defs/digest" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operation": {
      "type": "object",
      "required": ["action", "entityKind", "entityId", "baseDigest", "value"],
      "properties": {
        "action": { "enum": ["create", "move", "retire"] },
        "entityKind": { "enum": ["program", "thread", "item"] },
        "entityId": { "$ref": "#/$defs/id" },
        "baseDigest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "value": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}

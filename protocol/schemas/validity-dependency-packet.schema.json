{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/validity-dependency-packet.schema.json",
  "title": "Math Flow Validity Dependency Packet",
  "type": "object",
  "required": ["schemaVersion", "problemId", "subjectTransactionId", "subjectLedgerPosition", "claims", "dependencyTransactionIds", "knowledgeContext", "packetDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "problemId": { "type": "string" },
    "subjectTransactionId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "subjectLedgerPosition": { "type": "integer", "minimum": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claimKey", "statement", "dependencyTransactionIds"],
        "properties": {
          "claimKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
          "statement": { "type": "string", "minLength": 1 },
          "dependencyTransactionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "additionalProperties": false
      }
    },
    "dependencyTransactionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
    },
    "knowledgeContext": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["projectionId", "projectionSpecDigest", "runDigest", "stateDigest", "stateArtifactDigest", "problemLedgerHead", "selectedNodes", "unresolvedDependencyTransactionIds"],
          "properties": {
            "projectionId": { "type": "string" },
            "projectionSpecDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "runDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "stateDigest": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              ]
            },
            "stateArtifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "problemLedgerHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "selectedNodes": { "type": "object" },
            "unresolvedDependencyTransactionIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["sourceKind", "runDigest", "stateDigest", "stateArtifactDigest", "problemLedgerHead", "selectedPrograms", "selectedThreads", "selectedItems", "unresolvedDependencyTransactionIds"],
          "properties": {
            "sourceKind": { "const": "research-program-state" },
            "runDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "stateDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "stateArtifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "problemLedgerHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "selectedPrograms": { "type": "object" },
            "selectedThreads": { "type": "object" },
            "selectedItems": { "type": "object" },
            "unresolvedDependencyTransactionIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "packetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

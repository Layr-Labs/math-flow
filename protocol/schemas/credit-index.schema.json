{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.dev/schemas/credit-index.schema.json",
  "title": "Math Flow qualitative credit index",
  "type": "object",
  "required": [
    "schemaVersion",
    "problemId",
    "dependencyLockDigest",
    "assignments"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "problemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "dependencyLockDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "transactionId",
          "significance",
          "roles",
          "knowledgeRefs",
          "reservationTransactionIds",
          "reportSection"
        ],
        "properties": {
          "transactionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "significance": {
            "enum": [
              "foundational",
              "major",
              "supporting",
              "minor",
              "none",
              "uncertain"
            ]
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "direction-priority",
                "conjecture",
                "construction",
                "proof",
                "computation",
                "verification",
                "correction",
                "exposition",
                "other"
              ]
            }
          },
          "knowledgeRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["nodeId"],
              "properties": {
                "nodeId": { "type": "string", "minLength": 1 },
                "revisionId": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "reservationTransactionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "reportSection": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

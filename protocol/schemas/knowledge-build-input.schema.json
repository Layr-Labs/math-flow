{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/knowledge-build-input.schema.json",
  "title": "Immutable Knowledge Build Input",
  "type": "object",
  "required": [
    "schemaVersion",
    "laneId",
    "problemId",
    "builderSpecDigest",
    "baseStateRun",
    "judgmentIds",
    "conflictIds",
    "judgmentSetDigest",
    "buildToken"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "laneId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "problemId": { "type": "string" },
    "builderSpecDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "baseStateRun": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "judgmentIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "conflictIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "judgmentSetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "buildToken": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

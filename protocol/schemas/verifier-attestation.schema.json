{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/verifier-attestation.schema.json",
  "title": "Math Flow Objective Verifier Attestation",
  "type": "object",
  "required": ["schemaVersion", "attestationId", "subject", "verifier", "environment", "environmentDigest", "requestDigest", "inputs", "invocation", "result", "outputs", "producer"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "attestationId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subject": {
      "type": "object",
      "required": ["transactionId", "contributionId", "path"],
      "properties": {
        "transactionId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contributionId": { "type": "string" },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "required": ["id", "specDigest", "implementation"],
      "properties": {
        "id": { "type": "string" },
        "specDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "implementation": { "const": "oci-command-v1" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["kind", "image", "platform", "network", "readOnlyRoot", "user", "capabilities", "noNewPrivileges", "memoryBytes", "cpuCount", "pidsLimit", "tmpfsBytes"],
      "properties": {
        "kind": { "const": "oci" },
        "image": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/:~-]*@sha256:[0-9a-f]{64}$" },
        "platform": { "enum": ["linux/amd64", "linux/arm64"] },
        "network": { "const": "none" },
        "readOnlyRoot": { "const": true },
        "user": { "const": "65534:65534" },
        "capabilities": { "const": [] },
        "noNewPrivileges": { "const": true },
        "memoryBytes": { "type": "integer", "minimum": 16777216, "maximum": 17179869184 },
        "cpuCount": { "type": "integer", "minimum": 1, "maximum": 32 },
        "pidsLimit": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "tmpfsBytes": { "type": "integer", "minimum": 1048576, "maximum": 4294967296 }
      },
      "additionalProperties": false
    },
    "environmentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "digest", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "invocation": {
      "type": "object",
      "required": ["executable", "fixedArguments", "entrypoint", "arguments", "timeoutSeconds", "successExitCodes"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "fixedArguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
        "entrypoint": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "successExitCodes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 124 } }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status", "exitCode", "timedOut"],
      "properties": {
        "status": { "enum": ["passed", "failed", "error"] },
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": { "$ref": "#/$defs/output" },
        "stderr": { "$ref": "#/$defs/output" }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["implementation", "mathFlowVersion"],
      "properties": {
        "implementation": { "const": "math-flow-oci-attestation-producer-v1" },
        "mathFlowVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "required": ["digest", "bytes"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

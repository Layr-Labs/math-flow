{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/verifier-spec.schema.json",
  "title": "Math Flow Verifier Spec",
  "type": "object",
  "required": ["schemaVersion", "id", "description", "implementation", "environment", "command"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "implementation": { "const": "oci-command-v1" },
    "environment": {
      "type": "object",
      "required": ["kind", "image", "platform", "network", "readOnlyRoot", "user", "capabilities", "noNewPrivileges", "memoryBytes", "cpuCount", "pidsLimit", "tmpfsBytes"],
      "properties": {
        "kind": { "const": "oci" },
        "image": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/:~-]*@sha256:[0-9a-f]{64}$" },
        "platform": { "enum": ["linux/amd64", "linux/arm64"] },
        "network": { "const": "none" },
        "readOnlyRoot": { "const": true },
        "user": { "const": "65534:65534" },
        "capabilities": { "const": [] },
        "noNewPrivileges": { "const": true },
        "memoryBytes": { "type": "integer", "minimum": 16777216, "maximum": 17179869184 },
        "cpuCount": { "type": "integer", "minimum": 1, "maximum": 32 },
        "pidsLimit": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "tmpfsBytes": { "type": "integer", "minimum": 1048576, "maximum": 4294967296 }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["executable", "fixedArguments", "timeoutSeconds", "maximumOutputBytes", "successExitCodes"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "fixedArguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maximumOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "successExitCodes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 124 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

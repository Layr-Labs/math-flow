{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/verification-request.schema.json",
  "title": "Math Flow Contribution Verification Request",
  "type": "object",
  "required": ["schemaVersion", "verifier", "entrypoint", "arguments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verifier": {
      "type": "object",
      "required": ["id", "specDigest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "specDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "entrypoint": { "type": "string", "pattern": "^(?!/)(?!-)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "arguments": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/validity-judgment.schema.json",
  "title": "Math Flow Validity Judgment",
  "type": "object",
  "required": ["schemaVersion", "judgmentId", "judgmentKind", "problemId", "ledgerHead", "problemLedgerDigest", "judgeSpec", "subjects", "assessments", "findings", "dependencyPacketDigest", "reportDigest"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "judgmentId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "judgmentKind": { "const": "primary" },
    "problemId": { "type": "string" },
    "ledgerHead": { "type": "string" },
    "problemLedgerDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "judgeSpec": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id", "ledgerPosition"],
        "properties": {
          "kind": { "const": "transaction" },
          "id": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "ledgerPosition": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claimKey", "status", "premiseStatus", "summary", "scopeQualifications", "evidenceIssues", "evidenceTransactionIds"],
        "properties": {
          "claimKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
          "status": { "enum": ["valid", "invalid", "indeterminate"] },
          "premiseStatus": { "enum": ["satisfied", "missing", "disputed", "not-required"] },
          "summary": { "type": "string", "minLength": 1 },
          "scopeQualifications": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidenceIssues": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidenceTransactionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claimKey", "stance", "summary", "subjectTransactionIds", "evidenceTransactionIds"],
        "properties": {
          "claimKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
          "stance": { "enum": ["supports", "refutes", "uncertain"] },
          "summary": { "type": "string", "minLength": 1 },
          "subjectTransactionIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          },
          "evidenceTransactionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "additionalProperties": false
      }
    },
    "dependencyPacketDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reportDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

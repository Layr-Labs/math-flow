{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/research-program-delta-v5.schema.json",
  "title": "Audited Hierarchical Research Program Batch Delta v5",
  "type": "object",
  "required": ["schemaVersion", "operations", "contributions", "placementAudits"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entityKind", "entityId", "baseDigest", "value"],
        "properties": {
          "entityKind": { "enum": ["program", "thread", "item"] },
          "entityId": { "$ref": "#/$defs/id" },
          "baseDigest": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/digest" }
            ]
          },
          "value": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transactionId", "claimKeys", "directProgramId", "directThreadIds", "itemIds"],
        "properties": {
          "transactionId": { "$ref": "#/$defs/transaction" },
          "claimKeys": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "directProgramId": { "$ref": "#/$defs/id" },
          "directThreadIds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "itemIds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          }
        },
        "additionalProperties": false
      }
    },
    "placementAudits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transactionId", "basis", "rationale", "relatedProgramIds"],
        "properties": {
          "transactionId": { "$ref": "#/$defs/transaction" },
          "basis": { "enum": ["local-objective", "cross-program", "canonical-objective"] },
          "rationale": { "type": "string", "minLength": 1 },
          "relatedProgramIds": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
    "transaction": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

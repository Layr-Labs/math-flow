{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/research-builder-submission-input-v1.schema.json",
  "title": "Research Builder v6 Accepted Submission Input",
  "type": "object",
  "required": [
    "schemaVersion",
    "problemId",
    "subjectTransactionId",
    "ledgerOrdinal",
    "judgmentId",
    "acceptedClaims",
    "evidenceManifestDigest",
    "submissionInputDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "problemId": { "$ref": "#/$defs/id" },
    "subjectTransactionId": { "$ref": "#/$defs/transaction" },
    "ledgerOrdinal": { "type": "integer", "minimum": 1 },
    "judgmentId": { "$ref": "#/$defs/digest" },
    "acceptedClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claimKey", "statement", "dependencyTransactionIds"],
        "properties": {
          "claimKey": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1 },
          "dependencyTransactionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/transaction" }
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceManifestDigest": { "$ref": "#/$defs/digest" },
    "submissionInputDigest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
    "transaction": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

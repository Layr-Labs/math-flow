{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/knowledge-state-v3.schema.json",
  "title": "Neutral Facet-Aware Hierarchical Knowledge State",
  "type": "object",
  "required": ["schemaVersion", "problemId", "rootId", "nodes", "stateDigest"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "problemId": { "type": "string" },
    "rootId": { "const": "root" },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id", "parentId", "type", "title", "summary", "status",
          "reportRef", "contentMarkdown", "subjects", "evidence",
          "currentRevision", "digest"
        ],
        "properties": {
          "id": { "type": "string" },
          "parentId": { "type": ["string", "null"] },
          "type": {
            "enum": ["root", "program", "claim", "lemma", "question", "dispute", "method", "result"]
          },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "retired"] },
          "reportRef": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "knowledge-revision.schema.json#/$defs/reportRef" }
            ]
          },
          "contentMarkdown": { "type": "string" },
          "subjects": {
            "type": "array",
            "items": { "$ref": "knowledge-revision.schema.json#/$defs/subject" }
          },
          "evidence": {
            "type": "array",
            "items": { "$ref": "knowledge-revision.schema.json#/$defs/evidence" }
          },
          "currentRevision": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["revisionId", "revisionNumber"],
                "properties": {
                  "revisionId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "revisionNumber": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            ]
          },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "lineage": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["relation", "nodeId"],
              "properties": {
                "relation": { "enum": ["split-from", "split-into", "merged-from", "merged-into"] },
                "nodeId": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stateDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

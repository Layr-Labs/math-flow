{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/work-accounting-patch-v1.schema.json",
  "title": "Sparse Primitive Work-Accounting Patch V1",
  "type": "object",
  "required": [
    "schemaVersion",
    "problemId",
    "subjectTransactionId",
    "evaluationMode",
    "rootContractDigest",
    "baseAccountingStateDigest",
    "baseKnowledgeStateDigest",
    "targetKnowledgeStateDigest",
    "topologyAlignmentDigest",
    "updates",
    "patchDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "problemId": { "$ref": "#/$defs/id" },
    "subjectTransactionId": { "$ref": "#/$defs/transaction" },
    "evaluationMode": { "enum": ["no-access", "with-access"] },
    "rootContractDigest": { "$ref": "#/$defs/digest" },
    "baseAccountingStateDigest": { "$ref": "#/$defs/digest" },
    "baseKnowledgeStateDigest": { "$ref": "#/$defs/digest" },
    "targetKnowledgeStateDigest": { "$ref": "#/$defs/digest" },
    "topologyAlignmentDigest": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
    },
    "updates": {
      "type": "array",
      "items": { "$ref": "#/$defs/update" }
    },
    "patchDigest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "transaction": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "decimal": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
    },
    "probability": {
      "allOf": [
        { "$ref": "#/$defs/decimal" },
        { "pattern": "^(?:0(?:\\.[0-9]*[1-9])?|1)$" }
      ]
    },
    "nodeRef": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["program", "thread"] },
        "id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "directWorkHours": { "$ref": "#/$defs/decimal" },
        "conditionalIncidence": { "$ref": "#/$defs/probability" }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": [
        "nodeRef",
        "baseAnnotationDigest",
        "changes",
        "rationale",
        "evidenceRefs"
      ],
      "properties": {
        "nodeRef": { "$ref": "#/$defs/nodeRef" },
        "baseAnnotationDigest": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        },
        "changes": { "$ref": "#/$defs/changes" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}

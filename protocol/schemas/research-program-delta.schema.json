{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-flow.local/schemas/research-program-delta.schema.json",
  "title": "Research Program Transition Delta",
  "type": "object",
  "required": ["schemaVersion", "operations", "contribution"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entityKind", "entityId", "baseDigest", "value"],
        "properties": {
          "entityKind": { "enum": ["program", "thread", "item"] },
          "entityId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
          "baseDigest": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            ]
          },
          "value": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "contribution": {
      "type": "object",
      "required": ["claimKeys", "directProgramId", "directThreadIds", "itemIds"],
      "properties": {
        "claimKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" }
        },
        "directProgramId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
        "directThreadIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" }
        },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
